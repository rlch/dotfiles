#!/usr/bin/env bash
# No browser MCP server at session start (2026-10-01). Claude Code starts every
# stdio MCP server when a session opens, used or not (anthropics/claude-code
# #82952). With 23 sessions open, the user-scope chrome-devtools and
# playwright servers plus their plugin twins were 171 processes and 11.6 GB.
# Browsers are driven on demand by the vendors' CLIs instead: Microsoft's
# `playwright-cli` and the `chrome-devtools` CLI the chrome-devtools-mcp
# package ships. Both attach to the one ungoogled Chromium on 127.0.0.1:9222
# (`chrome-debug`), and the `browser` skill says how. The plugins are disabled
# in settings.json and the npm globals are installed by the claude-plugins
# script.
#
# Idempotent: remove the user-scope entries this script used to add.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v claude >/dev/null 2>&1; then
  echo "browser-mcp: claude CLI not on PATH — skipping"
  exit 0
fi

for name in chrome-devtools playwright; do
  claude mcp remove "$name" -s user >/dev/null 2>&1 || true
done
echo "browser-mcp: no browser MCP server is registered; the browser skill drives the CLIs"
{{- end }}
