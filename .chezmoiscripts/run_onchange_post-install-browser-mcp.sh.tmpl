#!/usr/bin/env bash
# Register the browser-automation MCP servers as USER-scope (~/.claude.json),
# attached to the ungoogled-Chromium debug instance on 127.0.0.1:9222 (the
# `chrome-debug` fish function). The official claude-plugins versions
# (chrome-devtools-mcp@/playwright@) ship without --browser-url, so they launch
# their OWN Chrome — violating the visual-separation invariant in CLAUDE.md.
# We disable those plugins (settings.json enabledPlugins) and own these instead,
# same idiom as install-blender-mcp.sh.
#
# Idempotent: remove any stale user-scope entry, then add the :9222 version.
# A "failed to connect" in `claude mcp list` just means chrome-debug isn't
# running yet — start it with the `chrome-debug` fish function.
#
# Concurrent-session model: every Claude Code session starts its OWN
# chrome-devtools-mcp server, and with --browser-url they ALL attach to the one
# :9222 Chromium (one shared browser, by design — the visual-separation
# invariant wants a single distinct instance, not one-per-session). The failure
# mode that bites is contention: sessions fight over a single global "selected
# page". --experimentalPageIdRouting exposes pageId on page-scoped tools so each
# session routes calls to its OWN tab — the documented fix for concurrent-agent
# tab contention (chrome-devtools-mcp#926/#2052). It's experimental + global
# (every project, both hosts); revert by dropping the flag below. Discipline
# still applies: each session drives its own `new_page`, never the active tab.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v claude >/dev/null 2>&1; then
  echo "browser-mcp: claude CLI not on PATH — claude-code not yet installed; skipping"
  exit 0
fi

add_mcp() {  # <name> <command> [args...]
  local name="$1"; shift
  claude mcp remove "$name" -s user >/dev/null 2>&1 || true
  echo "browser-mcp: registering user-scope '$name' (attaches to :9222)"
  claude mcp add -s user "$name" -- "$@"
}

add_mcp chrome-devtools chrome-devtools-mcp --browser-url=http://127.0.0.1:9222 --no-category-extensions --experimentalPageIdRouting
add_mcp playwright      playwright-mcp      --cdp-endpoint=http://127.0.0.1:9222
{{- end }}
