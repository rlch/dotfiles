#!/usr/bin/env bash
# Sentry for agents is the `sentry` skill (~/dev/skills), which calls the API
# through ~/.local/bin/sentry-mcp-token with a token file — not an MCP server.
# The user-scope stdio servers `sentry` (tutero-au) and `sentry-abyme`
# (abyme.sentry.io, which abyme no longer uses) this script used to register in
# every Claude account dir cost two node processes per agent (190 servers,
# 13.6 GB on 2026-10-24), so it now removes both and adds none. The hosted plugin
# (`sentry@claude-plugins-official`) stays disabled in dot_claude/settings.json:
# it authorized per account by OAuth and lapsed.

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v claude >/dev/null 2>&1; then
  echo "sentry-mcp: claude CLI not on PATH; skipping"; exit 0
fi

for dir in "$HOME/.claude" "$HOME"/.claude-*; do
  case "$dir" in *-swap-backup) continue ;; esac
  [ -f "$dir/.claude.json" ] || continue
  for name in sentry sentry-abyme; do
    if CLAUDE_CONFIG_DIR="$dir" claude mcp remove -s user "$name" >/dev/null 2>&1; then
      echo "sentry-mcp: removed $name from $(basename "$dir")"
    fi
  done
done
{{- end }}
