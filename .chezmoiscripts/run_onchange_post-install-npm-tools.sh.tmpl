#!/usr/bin/env bash
# Install npm global packages that aren't on Homebrew. Reruns whenever the
# Brewfile hash changes (so additions to the npm block stay in sync).
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

if ! command -v npm >/dev/null 2>&1; then
  echo "npm-tools: npm not on PATH — Brewfile not applied; skipping"
  exit 0
fi

# Keep the installed check filesystem-based: `npm ls -g --json` can be slow
# or hang under pnpm/npm script-approval state, and scoped package names need
# awkward regex escaping.
npm_root=$(npm root -g)

# @inbox-zero/cli — self-hosted Inbox Zero manager; wraps setup/start/stop/logs
# for the Dockerized AI email assistant (requires Docker + Node 24+).
need=(@fission-ai/openspec @inbox-zero/cli)

for pkg in "${need[@]}"; do
  if [ -d "${npm_root}/${pkg}" ]; then
    echo "npm-tools: ${pkg} already installed"
  else
    echo "npm-tools: installing ${pkg}@latest"
    npm install -g "${pkg}@latest"
  fi
done
