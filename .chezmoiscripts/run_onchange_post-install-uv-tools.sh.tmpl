#!/usr/bin/env bash
# Install uv-managed Python CLIs that aren't on Homebrew. Reruns whenever
# this script's contents change (e.g. when a tool is added to `need=`).
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

if ! command -v uv >/dev/null 2>&1; then
  echo "uv-tools: uv not on PATH — Brewfile not applied; skipping"
  exit 0
fi

# Each entry: "<package> [extra-with-deps...]". Trailing tokens are injected into
# the tool's own venv via `uv tool install --with`. jupyterlab is the browser
# frontend for the drift experiment notebooks (evcxr rust kernel); jupyterlab-vim
# adds vim keybindings (prebuilt extension, auto-enabled in JupyterLab 4). Reinstall
# unconditionally so `--with` deps stay in sync; this script only reruns on change.
need=(
  "jupyterlab jupyterlab-vim"
)

for spec in "${need[@]}"; do
  read -r pkg withs <<<"${spec}"
  with_args=()
  for w in ${withs}; do with_args+=(--with "${w}"); done
  echo "uv-tools: installing ${pkg}${withs:+ (with: ${withs})}"
  uv tool install "${with_args[@]}" "${pkg}"
done
