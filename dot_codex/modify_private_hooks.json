#!/usr/bin/env python3
"""Remove every Unspoke hook (operator, 2026-11-03: Unspoke is gone).

Hook installers own this file. Preserve their registrations and remove only
hooks whose executable is an `unspoke` binary.
"""
import json
from pathlib import Path
import shlex
import sys


def stale_test_hook(hook):
    try:
        command = shlex.split(hook.get("command", ""))
    except ValueError:
        return False
    return bool(command) and Path(command[0]).name == "unspoke"


content = sys.stdin.read()
document = json.loads(content or "{}")
changed = False
for event, groups in list(document.get("hooks", {}).items()):
    kept_groups = []
    for group in groups:
        hooks = group.get("hooks", [])
        kept_hooks = [hook for hook in hooks if not stale_test_hook(hook)]
        if len(kept_hooks) == len(hooks):
            kept_groups.append(group)
            continue
        changed = True
        if kept_hooks:
            kept_groups.append({**group, "hooks": kept_hooks})
    if kept_groups:
        document["hooks"][event] = kept_groups
    elif groups:
        del document["hooks"][event]

sys.stdout.write(json.dumps(document, indent=2) + "\n" if changed else content)
