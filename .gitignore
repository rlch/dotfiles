# Environment files — never track. Templates (.example, .sample, .template)
# are explicitly allowed back so dot_env.example stays trackable.

# Literal .env at any depth
.env
.env.*
!.env.example
!.env.sample
!.env.template

# chezmoi source names (dot_env → ~/.env on apply)
dot_env
dot_env.*
!dot_env.example
!dot_env.sample
!dot_env.template

# Runtime artefacts — playwright-mcp / chrome-devtools-mcp dump session
# console logs in CWD when invoked from this repo. Not config; ignore.
.playwright-mcp/

# Python bytecode caches (slugify-title.py et al.).
__pycache__/
*.pyc

# --- Kept OUT of the public repo (still deployed locally by chezmoi) ---
# Personal / host-specific / self-hosted config. chezmoi manages these from the
# working tree regardless of git, so `chezmoi apply` still deploys them — they
# just never get committed or pushed to the public repo. Preserves the privacy
# scrub while keeping one repo + one apply.
private_dot_ssh/
dot_config/homepage/
dot_config/searxng/
dot_config/nats-server/
Library/LaunchAgents/
dot_config/gh-dash/
dot_config/ollama/
dot_config/fish/functions/mini-mount.fish
dot_config/fish/functions/mini-umount.fish
dot_config/fish/functions/modality.fish
dot_config/fish/functions/subflow.fish
dot_local/bin/executable_inbox-zero
