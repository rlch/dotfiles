{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "2000"
  },
  "permissions": {
    "deny": [
      "Artifact",
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(sudo passwd:*)",
      "Bash(sudo useradd:*)",
      "Bash(sudo userdel:*)",
      "Bash(sudo rm /etc/*)",
      "Bash(sudo > /etc/*)",
      "Bash(docker run --privileged:*)",
      "Bash(docker run --pid=host:*)",
      "Bash(docker run -v /:/host *)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin master:*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.ssh/id_*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/rjm"
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Agent|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ABYME_AGENT\" ] || ~/.claude/pretool.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ABYME_AGENT\" ] || ~/.claude/lsp-cleanup-hook.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "abyme@abyme": true,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "ck@cavekit-marketplace": false,
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "abyme": {
      "source": {
        "source": "directory",
        "path": "/Users/rjm/.local/state/abyme/claude"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "notifications_disabled",
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "theme": "dark"
}
