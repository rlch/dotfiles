{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "2000"
  },
  "permissions": {
    "allow": [
      "Bash(herdr agent start:*)"
    ],
    "deny": [
      "Artifact",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf /)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(sudo passwd:*)",
      "Bash(sudo useradd:*)",
      "Bash(sudo userdel:*)",
      "Bash(sudo rm /etc/*)",
      "Bash(sudo > /etc/*)",
      "Bash(docker run --privileged:*)",
      "Bash(docker run --pid=host:*)",
      "Bash(docker run -v /:/host *)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin master:*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.ssh/id_*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/rjm"
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": false
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "bash '/Users/rjm/.claude/hooks/herdr-agent-state.sh' blocked",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/rtk-hook.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "bash '/Users/rjm/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/improvement-capture.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/lsp-cleanup-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "bash '/Users/rjm/.claude/hooks/herdr-agent-state.sh' release",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/rjm/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/herdr-title.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "bash '/Users/rjm/.claude/hooks/herdr-agent-state.sh' idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjm/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "bash '/Users/rjm/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "abyme@abyme": true,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "ck@cavekit-marketplace": false,
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "abyme": {
      "source": {
        "source": "directory",
        "path": "/Users/rjm/.local/state/abyme/claude"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "notifications_disabled",
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "theme": "dark"
}
