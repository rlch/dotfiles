# === Theme + visuals ===
theme         = "Catppuccin Mocha"
font-family   = "JetBrainsMono Nerd Font"
font-size     = 15
cursor-style       = bar
cursor-style-blink = false

# Terminal text selection — Catppuccin Mocha Surface2, the canonical Catppuccin
# selection bg (the bundled theme's default reads as a non-Catppuccin blue).
# Foreground left unset so selected text keeps its own colors.
selection-background = 585b70

# === Window chrome ===
macos-titlebar-style   = hidden
window-padding-x       = 6
window-padding-y       = 4
window-padding-balance = true
window-save-state      = always
background-blur        = macos-glass-regular

# === UX ===
mouse-hide-while-typing        = true
confirm-close-surface          = false
clipboard-trim-trailing-spaces = true

# Drop OSC 9 / OSC 777 desktop-notification escape sequences. Claude Code's
# `auto` notif channel, plus any other CLI tool that asks the terminal to
# pop a macOS banner, route through this — flipping it false short-circuits
# the lot at the terminal level. Tmux's bell only sets the in-status badge
# (@tab-transient in tmux.conf); it doesn't go through OSC 9, so the in-tmux
# "agent awaiting reply" glyph still works.
desktop-notifications = false

# === SSH terminfo propagation ===
# Defaults are: cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
# Opt into the two ssh-* features so remote hosts get correct TERM and a
# bundled xterm-ghostty terminfo (cached per host) — otherwise SSH targets
# without the entry render undercurl/italics/colors as garbage.
shell-integration-features = ssh-env,ssh-terminfo

# === Keybinds ===
# alt+backspace → delete word backwards. Without this, Option+Backspace sends
# nothing useful to TUI apps (Claude Code, bash, readline) — Ghostty's
# macos-option-as-alt is unset by default, so Option is a special-character
# modifier rather than Alt. Surgical bind so Option's other behaviors stay
# intact (no global macos-option-as-alt).
keybind = alt+backspace=text:\x1b\x7f

# ctrl+slash → emit CSI-u so tmux can distinguish it from ctrl+_. Ghostty's
# encoder silently drops this key by default (no byte emitted at all), so
# we manually send the CSI-u sequence via csi: (which builds ESC [ ... and
# doesn't depend on text-escape interpretation). 47 = '/' codepoint,
# 5 = ctrl modifier per CSI-u spec. Tmux with `extended-keys on` decodes
# this as C-/ and fires the session+window switcher (with preview).
keybind = ctrl+slash=csi:47;5u

# ctrl+space → emit CSI-u so tmux's prefix2=C-Space binding fires reliably.
# Legacy encoding maps Ctrl+Space to NUL (0x00) which tmux can match, but
# Ghostty's encoder is unreliable here (same family of bugs as ctrl+slash).
# 32 = ' ' codepoint, 5 = ctrl modifier.
keybind = ctrl+space=csi:32;5u

# ctrl+shift+g → emit CSI-u so tmux's `bind -T root C-S-g` (scratch
# session toggle) fires. Karabiner remaps a Globe (fn) tap and a
# Moonlander caps-lock tap to ctrl+shift+g when Ghostty is frontmost
# (private_karabiner.json). 103 = 'g' codepoint (lowercase — CSI-u
# encodes the unshifted character), 6 = ctrl+shift modifier. Without
# this binding the chord still encodes, but `extended-keys`-style
# routing is unreliable for ctrl+shift+letter on some Ghostty paths;
# the explicit csi: spelling matches the rest of the family.
keybind = ctrl+shift+g=csi:103;6u

# ctrl+y → emit CSI-u so tmux's `bind C-y display-popup yazi` fires.
# Karabiner remaps the spotlight key (F4 / apple_vendor `spotlight` /
# `launchpad`) to ctrl+y inside Ghostty. The legacy Ctrl+Y byte (0x19) is
# the emacs/fish "yank" character — by upgrading to CSI-u via this
# keybind, tmux intercepts before fish and the yank shortcut is sacrificed
# only inside tmux. 121 = 'y' codepoint, 5 = ctrl modifier.
keybind = ctrl+y=csi:121;5u

# cmd+1..9 → emit CSI-u with the SUPER modifier so herdr reads ⌘1-9 as a
# workspace jump ([keys.indexed] workspaces = "cmd" in herdr's config.toml).
# Modifier 9 = 1 + super(8); codepoints 49..57 = '1'..'9'.
#
# History: this used to masquerade cmd+digit as ctrl+digit (modifier 5) to
# drive tmux `C-1..9 select-window`. Dropped now that Ghostty hosts herdr,
# not tmux — herdr needs the real super modifier so it can tell ⌘1-9
# (workspace) apart from ⌃1-9 (tab, which reaches herdr natively via the
# kitty protocol, no keybind needed). If you go back to a tmux-in-Ghostty
# session, this row is what tmux's cmd+digit window-jump lost.
#
# Trigger spelling matters: Ghostty's default `super+digit_N=goto_tab:N`
# uses the physical-digit key code, distinct from the character keysym
# `super+N`. `cmd+one` parses as `super+1` (character form) and leaves the
# goto_tab default *unshadowed*; `cmd+digit_N` lands on the same trigger
# and properly overrides it.
keybind = cmd+digit_1=text:\x1b[49;9u
keybind = cmd+digit_2=text:\x1b[50;9u
keybind = cmd+digit_3=text:\x1b[51;9u
keybind = cmd+digit_4=text:\x1b[52;9u
keybind = cmd+digit_5=text:\x1b[53;9u
keybind = cmd+digit_6=text:\x1b[54;9u
keybind = cmd+digit_7=text:\x1b[55;9u
keybind = cmd+digit_8=text:\x1b[56;9u
keybind = cmd+digit_9=text:\x1b[57;9u

# ctrl+shift+digit_N — jump to Nth session (alphabetical order). Same
# trick as cmd+digit_N above, but modifier 6 (ctrl+shift) instead of 5
# (ctrl), so tmux reads it as C-S-1..9/C-S-0 and the corresponding
# `bind -T root C-S-N run-shell tmux-switch-session.sh N` fires. digit_0
# is the 10th slot (codepoint 48), completing the row — 10 is the
# single-keypress max since there are only ten digit keys.
#
# Trigger is ctrl+shift (not cmd+shift): cmd+shift+3/4 are owned globally
# by Shottr (screenshot) and cmd+shift+5 by the macOS capture toolbar, so
# those slots never reached the terminal. ctrl+shift+digit has no system
# grab, so all ten slots work. The on-the-wire sequence is unchanged —
# tmux still sees C-S-N — so the tmux bindings stay as-is.
keybind = ctrl+shift+digit_1=text:\x1b[49;6u
keybind = ctrl+shift+digit_2=text:\x1b[50;6u
keybind = ctrl+shift+digit_3=text:\x1b[51;6u
keybind = ctrl+shift+digit_4=text:\x1b[52;6u
keybind = ctrl+shift+digit_5=text:\x1b[53;6u
keybind = ctrl+shift+digit_6=text:\x1b[54;6u
keybind = ctrl+shift+digit_7=text:\x1b[55;6u
keybind = ctrl+shift+digit_8=text:\x1b[56;6u
keybind = ctrl+shift+digit_9=text:\x1b[57;6u
keybind = ctrl+shift+digit_0=text:\x1b[48;6u

# ctrl+[ / ctrl+] — jump to prev/next window with Claude's "awaiting reply"
# bell (or any TUI hardware bell). ctrl+shift+[ / ctrl+shift+] do the same
# across all sessions. Sent as CSI-u so tmux can distinguish them — without
# this, ctrl+[ collapses to the ESC byte (0x1B) and shift on a non-letter
# key never reaches the wire. Codepoints: 91 = '[', 93 = ']'. Modifiers:
# 5 = ctrl, 6 = ctrl+shift. Tmux binds them as C-[ / C-] / C-S-[ / C-S-].
keybind = ctrl+bracket_left=csi:91;5u
keybind = ctrl+bracket_right=csi:93;5u
keybind = ctrl+shift+bracket_left=csi:91;6u
keybind = ctrl+shift+bracket_right=csi:93;6u

# === herdr ⌘-forwarding =================================================
# herdr runs standalone in Ghostty and mirrors cmux's keymap, which leans
# on ⌘ chords for create/nav (see ~/.config/herdr/config.toml — the two
# files are a matched pair). macOS hands ⌘ to the app, so Ghostty must be
# told to forward each chord to the running TUI as a CSI-u *super*
# sequence: modifier 9 = 1+super, 10 = 1+super+shift. herdr decodes these
# as ⌘<key>.
#
# Scope caveat: these are GLOBAL Ghostty binds — they override Ghostty's
# own ⌘T/⌘N/⌘W/⌘D (tab/window/split) and macOS ⌘H (hide) for every Ghostty
# window, not just herdr's. That's intended: this Ghostty is a passive host
# so herdr owns multiplexing (a fair comparison vs cmux). A non-herdr shell
# just ignores the unknown CSI-u — harmless. ⌘C/⌘V/⌘Q are left native.
# Codepoints: h104 j106 k107 l108 t116 n110 d100 w119 b98 p112.
keybind = cmd+h=csi:104;9u         # herdr previous_tab       (cmux ⌘H)
keybind = cmd+l=csi:108;9u         # herdr next_tab           (cmux ⌘L)
keybind = cmd+k=csi:107;9u         # herdr previous_workspace (cmux ⌘K)
keybind = cmd+j=csi:106;9u         # herdr next_workspace     (cmux ⌘J)
keybind = cmd+t=csi:116;9u         # herdr new_tab            (cmux ⌘T)
keybind = cmd+n=csi:110;9u         # herdr new_workspace      (cmux ⌘N)
keybind = cmd+d=csi:100;9u         # herdr split_vertical     (cmux ⌘D)
keybind = cmd+shift+d=csi:100;10u  # herdr split_horizontal   (cmux ⌘⇧D)
keybind = cmd+w=csi:119;9u         # herdr close_tab          (cmux ⌘W)
keybind = cmd+b=csi:98;9u          # herdr toggle_sidebar     (cmux ⌘B)
keybind = cmd+p=csi:112;9u         # herdr workspace_picker   (cmux ⌘P)
