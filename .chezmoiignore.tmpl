# Files that live in the source repo but shouldn't be deployed to ~
Brewfile
Brewfile.heavy
CLAUDE.md
README.md
LICENSE
.git/
.gitignore
**/.DS_Store
**/__pycache__
**/*.pyc

# OpenD (moomoo trading gateway) + nats-server (JetStream bus) + abymed only run on
# the mbp; on a non-mbp host they'd loop on missing binaries. Skip them there.
{{ if ne .role "mbp" -}}
Library/LaunchAgents/com.moomoo.opend.plist
Library/LaunchAgents/com.synadia.nats-server.plist
Library/LaunchAgents/com.rjm.wireproxy-nl.plist
Library/LaunchAgents/com.rjm.abymed.plist
Library/LaunchAgents/com.rjm.cloudflared-mac.plist
{{- end }}

# wireproxy's WG config carries a ProtonVPN private key — never manage/commit it.
.config/wireproxy

# The Mac's Tunnel token (com.rjm.cloudflared-mac) is a secret.
.config/cloudflared

# The accounts plugin's picker test runs from the source; abymed has no use for it.
.config/abyme/accounts/test.ts

# Tests for the scripts here; not deployed.
tests/

# Scripts run from this checkout (.abyme/processes.ts); not deployed.
scripts/
