#!/usr/bin/env python3
"""Trust one folder in every Claude Code account config before launching there.

Claude Code's trust check walks UP from the cwd looking for
projects[<dir>].hasTrustDialogAccepted, but the walk STOPS at the git toplevel
of the cwd (cli.js: FF -> BF with LL(cwd) as the boundary). So trust on $HOME or
~/dev never reaches inside a repo, and every fresh git worktree (a herdr
worktree under ~/.herdr/worktrees/<repo>/<slug>, a submodule checkout, a
clone) prompts "Do you trust the files in this folder?" until ITS OWN toplevel
has an entry. ~/dev/parley stopped prompting only because it was accepted once.

`cl` calls this with the launch dir right before exec'ing claude, so whichever
account clodcurrent picks, the folder is already trusted. Writes every
~/.claude*/.claude.json (the account is not known yet), atomically, and only
when an entry is missing or false. Usage: claude-trust-path [DIR]
"""
import glob, json, os, subprocess, sys, tempfile


def toplevel(path):
    try:
        out = subprocess.run(
            ["git", "-C", path, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        if out:
            return os.path.realpath(out)
    except (OSError, subprocess.CalledProcessError):
        pass
    return os.path.realpath(path)


def main():
    target = toplevel(sys.argv[1] if len(sys.argv) > 1 else os.getcwd())
    home = os.path.expanduser("~")
    if not (target == home or target.startswith(home.rstrip("/") + "/")):
        print(f"claude-trust-path: refusing to trust {target} (outside $HOME)", file=sys.stderr)
        return 1
    changed = []
    cfgs = sorted(glob.glob(os.path.expanduser("~/.claude/.claude.json")) +
                  glob.glob(os.path.expanduser("~/.claude-*/.claude.json")))
    for cfg in cfgs:
        if "/.claude-swap-backup/" in cfg:
            continue
        try:
            with open(cfg) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        entry = d.setdefault("projects", {}).setdefault(target, {})
        if entry.get("hasTrustDialogAccepted") is True and entry.get("hasCompletedProjectOnboarding") is True:
            continue
        entry["hasTrustDialogAccepted"] = True
        entry["hasCompletedProjectOnboarding"] = True
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(cfg))
        try:
            with os.fdopen(fd, "w") as fh:
                json.dump(d, fh, indent=2)
            with open(tmp) as fh:
                json.load(fh)
            os.replace(tmp, cfg)
        except Exception:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
        changed.append(os.path.basename(os.path.dirname(cfg)))
    print(f"claude-trust-path: {target} trusted in {len(changed)} config(s)"
          + (f": {', '.join(changed)}" if changed else " (all already current)"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
