#!/usr/bin/env bash
# omniwm-monitor focus|move <n>: focus monitor n, or move the focused workspace to it.
# Monitors count 1.. from the leftmost; OmniWM itself only knows next/previous and directions.
set -euo pipefail
action=${1:?focus or move}
n=${2:?monitor number}

displays=$(omniwmctl query displays --format json | jq -c '[.result.payload.displays | sort_by(.frame.x)[] | {id, current: .isCurrent, ws: .activeWorkspace.rawName}]')
count=$(jq length <<<"$displays")
((n >= 1 && n <= count)) || exit 0
target=$(jq -r ".[$((n - 1))].id" <<<"$displays")
current=$(jq -r 'map(.current) | index(true)' <<<"$displays")
((current + 1 == n)) && exit 0

case $action in
focus)
  for ((i = 0; i < count; i++)); do
    omniwmctl command focus-monitor next >/dev/null
    [[ $(omniwmctl query displays --format json | jq -r '.result.payload.displays[] | select(.isCurrent).id') == "$target" ]] && break
  done
  ;;
move)
  ws=$(jq -r ".[$current].ws" <<<"$displays")
  if ((n - 1 > current)); then dir=right steps=$((n - 1 - current)); else dir=left steps=$((current - n + 1)); fi
  for ((i = 0; i < steps; i++)); do
    omniwmctl workspace move-to-monitor "$ws" "$dir" >/dev/null
  done
  ;;
esac
