#!/usr/bin/env bash
# pr-review <owner/repo> <number> <repo-path> [--dry-run]
# Start a review agent for one pull request, in its own herdr worktree workspace.
# Bound to a key in gh-dash (~/.config/gh-dash/config.yml); the agent follows the
# rjm:pr-review skill. Never takes focus.
set -euo pipefail
REPO=${1:?owner/repo}; N=${2:?pr number}; DIR=${3:?local path of the repo}; DRY=${4:-}
DIR="${DIR/#\~/$HOME}"
git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || { echo "pr-review: $DIR is not a checkout of $REPO"; exit 1; }
DIR=$(dirname "$(git -C "$DIR" rev-parse --path-format=absolute --git-common-dir)")
read -r STATE DRAFT HEAD < <(gh pr view "$N" --repo "$REPO" --json state,isDraft,headRefName \
  --jq '"\(.state) \(.isDraft) \(.headRefName)"')
[ "$STATE" = OPEN ] || { echo "pr-review: #$N is $STATE"; exit 1; }
[ "$DRAFT" = false ] || { echo "pr-review: #$N is a draft; drafts are left alone"; exit 1; }
BR="pr-$N"
BRIEF="${TMPDIR:-/tmp}/pr-review-${REPO//\//-}-$N.md"
PURPOSE="review PR #$N of $REPO"
if [ "$DRY" = --dry-run ]; then
  echo "would fetch pull/$N/head into $BR in $DIR and start a review agent in a worktree workspace named $BR"; exit 0
fi
if herdfile tree 2>/dev/null | grep -qE "[ ─]$BR( |$)"; then
  echo "pr-review: #$N already has a workspace open ($BR)"; exit 0
fi
git -C "$DIR" show-ref --verify -q "refs/heads/$BR" || git -C "$DIR" fetch -q origin "pull/$N/head:$BR"
printf 'Use the rjm:pr-review skill on pull request %s of %s (head branch %s). You are in its worktree, on branch %s.\n' \
  "$N" "$REPO" "$HEAD" "$BR" > "$BRIEF"
# One command: the worktree workspace (opened where the fetched branch stands),
# the agent through `cl`, and the brief. It never takes focus.
if herdfile ws add "$BR" --dir "$DIR" --branch "$BR" --purpose "$PURPOSE" --brief "$BRIEF" --model opus; then
  echo "pr-review: #$N review agent started in workspace $BR"
else
  echo "pr-review: #$N could not be started; see the message above"; [ -t 0 ] && read -n1 -r -p "press any key " || true; exit 1
fi
[ -t 1 ] && sleep 2 || true
