#!/usr/bin/env bash
# Call a Slack Web API method AS RICHARD with his user token (xoxp), e.g.:
#   slack-api chat.postMessage channel=#schools text="hello"     (POST form fields)
#   slack-api conversations.history channel=C123 limit=20
# The token is read from ~/.config/slack/user-token (0600); it is never printed.
set -euo pipefail
m=${1:?method}; shift
tok=$(tr -d '[:space:]' < "$HOME/.config/slack/user-token")
args=(); for kv in "$@"; do args+=(--data-urlencode "$kv"); done
curl -s -X POST "https://slack.com/api/$m" -H "Authorization: Bearer $tok" "${args[@]}"
