#!/usr/bin/env bash
# Sentry for agents, authenticated by a token FILE read at call time — never
# OAuth, never a secret in a repo. The `sentry` skill (~/dev/skills) calls it:
#   sentry-mcp-token <command...>   runs <command> with SENTRY_AUTH_TOKEN,
#                                   SENTRY_ORG and SENTRY_URL set (curl, sentry-cli)
#   sentry-mcp-token                starts @sentry/mcp-server, for sessions started
#                                   before the MCP registrations were removed
#                                   (2026-10-24: 190 servers, 13.6 GB)
# The org is tutero-au, with its `iac` internal integration's token (org:read,
# project:read/write/admin, releases, team). abyme no longer uses Sentry.
# SENTRY_TOKEN_FILE overrides the file.
set -euo pipefail

ORG=tutero-au
TOKEN_FILE="${SENTRY_TOKEN_FILE:-$HOME/.config/schools-ts-preview/sentry-auth-token}"
if [ ! -r "$TOKEN_FILE" ]; then
  echo "sentry-mcp-token: no token at $TOKEN_FILE" >&2
  exit 1
fi
SENTRY_ACCESS_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
SENTRY_AUTH_TOKEN="$SENTRY_ACCESS_TOKEN"
SENTRY_ORG="$ORG"
SENTRY_URL="https://sentry.io/"
export SENTRY_ACCESS_TOKEN SENTRY_AUTH_TOKEN SENTRY_ORG SENTRY_URL
if [ "$#" -gt 0 ]; then
  exec "$@"
fi
exec npx -y @sentry/mcp-server@0.40.0 --organization-slug="$ORG"
