# Dictation belongs to Superwhisper, not Talon. F18 is its toggleRecording
# hotkey (the same key the Karabiner Right-Command tap sends). Hold Shift
# when stopping and Superwhisper presses Enter after pasting. Or say
# "dispatch" alone to stop and send (superwhisper.py).
mode: user.lean
mode: command
-
^whisper$: key(f18)
